# Pizza 42 — Frontend environment variables (example)
# Copy this file to .env and replace placeholders with your Auth0 tenant values.
# These are PUBLIC values — Vite inlines them into the bundle at build time.

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_API_AUDIENCE=https://pizza42-api
