# Pizza 42 — Backend environment variables (example)
# In production, these are injected via Kubernetes Secrets, never committed.

# Auth0 tenant
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://pizza42-api

# Machine-to-Machine credentials for Auth0 Management API
# (used to read/write user.app_metadata.orders)
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret
